import { MetadataRoute } from 'next'

export default function sitemap(): MetadataRoute.Sitemap {
  const baseUrl = 'https://buhouthal.vercel.app'

  const articles = [
    'ادوات-الطالب-الجامعي',
    'اعادة-الصياغة-الاكاديمية',
    'افضل-محركات-البحث-الاكاديمي',
    'الفرق-بين-البحث-والرسالة',
    'تحويل-PDF-الى-Word',
    'APA-توثيق-المراجع',
    'فحص-الاستلال-والانتحال',
    'كيف-تتجنب-الاستلال',
    'كيف-تختار-عنوان-البحث',
    'كيف-تكتب-الاطار-النظري',
    'كيف-تنشر-بحثك-في-مجلة',
    'كيفية-كتابة-بحث-التخرج',
    'ملخص-البحوث-بالذكاء-الاصطناعي',
    'منهجية-البحث-العلمي',
  ]

  return [
    { url: baseUrl, lastModified: new Date() },
    { url: `${baseUrl}/articles`, lastModified: new Date() },
    ...articles.map((slug) => ({
      url: `${baseUrl}/articles/${slug}`,
      lastModified: new Date(),
    })),
  ]
}
